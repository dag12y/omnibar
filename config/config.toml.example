# Omnibar configuration file.
#
# Location: $XDG_CONFIG_HOME/omnibar/config.toml
#           (~/.config/omnibar/config.toml when XDG_CONFIG_HOME is unset)

config_version = 1

[core]
# Log level: debug, info, warn, error (default: info)
log_level = "info"

# Module configuration.
# Each module can be enabled or disabled independently.
# Modules are registered statically in Go code (see internal/modules/).
# A module's ModuleInfo.Enabled value is its default; an entry here
# overrides that default.
[modules]
  [modules.core]
  enabled = true

  # System monitor: CPU, memory, and swap.
  # interval_ms is the sampling interval in milliseconds (default 2000,
  # valid range 500-60000). Sampling only runs while a client is
  # subscribed, so idle cost is near zero.
  [modules.system_monitor]
  enabled = true
  interval_ms = 2000

[modules.keep_awake]
enabled = true

[modules.audio]
enabled = true

[modules.clipboard]
# Starts paused; collection is opt-in for each backend session.
enabled = true

# Permissions granted to modules.
#
# Permissions are quoted dotted strings because TOML bare keys cannot
# contain dots.
#
# A module can only use a capability if it both declares the permission
# (in its ModuleInfo, set at compile time) AND the user has granted it
# here.
#
# Missing or invalid grants fail closed: access is denied. A missing
# [permissions] table grants no permissions at all.
[permissions]
"system.info" = true
# Allows explicitly requested, timed idle/sleep inhibition.
"power.inhibit" = true
"window.manage" = false
"clipboard.read" = false
"clipboard.write" = false
"audio.control" = true
"screen.capture" = false
"process.manage" = false
"filesystem.access" = false
"network.access" = false
"package.manage" = false
